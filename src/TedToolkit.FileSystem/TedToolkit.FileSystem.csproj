<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\externals\TedToolkit\props\CodeAnalysis.props" />
  <Import Project="..\..\externals\TedToolkit\props\NugetPackage.props" />
  <Import Project="..\..\externals\TedToolkit\props\AlmostAllFrameworks.props" />

  <PropertyGroup>
    <Title>TedToolkit.FileSystem</Title>
    <Description>A small .NET library for normalized file system path value objects.</Description>
    <NoWarn>$(NoWarn);CA1724;RCS1231;CA2225</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TedToolkit.Localizations" />
    <PackageReference Include="Polyfill" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <Compile Include="$(PkgPolyfill)/contentFiles/cs/$(TargetFramework)/CallerArgumentExpressionAttribute.cs"
             Condition="Exists('$(PkgPolyfill)/contentFiles/cs/$(TargetFramework)/CallerArgumentExpressionAttribute.cs')" />
    <Compile Include="$(PkgPolyfill)/contentFiles/cs/$(TargetFramework)/Nullable/NotNullAttribute.cs"
             Condition="Exists('$(PkgPolyfill)/contentFiles/cs/$(TargetFramework)/Nullable/NotNullAttribute.cs')" />
    <Compile Include="$(PkgPolyfill)/contentFiles/cs/$(TargetFramework)/Nullable/DoesNotReturnAttribute.cs"
             Condition="Exists('$(PkgPolyfill)/contentFiles/cs/$(TargetFramework)/Nullable/DoesNotReturnAttribute.cs')" />
  </ItemGroup>

</Project>